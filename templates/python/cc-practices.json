{
  "languages": ["python"],
  "format": {
    "extensions": [".py"],
    "command": ["uv", "run", "ruff", "format", "{file}"]
  },
  "checks": {
    "lint": "uv run ruff check --output-format concise .",
    "format": "uv run ruff format --check .",
    "typecheck": "uv run mypy",
    "test": "uv run pytest -q --tb=short"
  },
  "allowAgentCommits": false
}
